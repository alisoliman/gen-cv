# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Guided Content Generation API

# Azure OpenAI
AOAI_ENDPOINT=https://your-azure-openai-endpoint.openai.azure.com/
AOAI_KEY=your-azure-openai-key
GPT_DEPLOYMENT=your-gpt-deployment-name
PROMPT_MODERATION_DEPLOYMENT=your-moderation-deployment-name
DALLE_DEPLOYMENT=your-dalle-deployment-name

# Azure OpenAI Whisper (Sweden Central)
AOAI_ENDPOINT_SWECE=https://your-whisper-endpoint.openai.azure.com/
AOAI_KEY_SWECE=your-whisper-key
WHISPER_DEPLOYMENT=your-whisper-deployment-name

# Content Safety
CONTENT_SAFETY_ENDPOINT=https://your-content-safety-endpoint.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=your-content-safety-key

# Optional: Image Generation APIs
STABILITY_API_KEY=your-stability-api-key
REPLICATE_API_KEY=your-replicate-api-key

# Optional: Azure ML for SDXL
AML_IMGEN_API_KEY=your-aml-api-key
AML_IMGEN_ONLINE_ENDPOINT_URL=https://your-aml-endpoint.inference.ml.azure.com/score
AML_DEPLOYMENT_NAME=your-aml-deployment-name

# Optional: Azure AI Vision
AZURE_AI_VISION_ENDPOINT=https://your-vision-endpoint.cognitiveservices.azure.com/
AZURE_AI_VISION_KEY=your-vision-key
AZURE_AI_VISION_DEPLOYMENT=your-vision-deployment-name

# File storage paths
UPLOAD_DIR=./static/uploads
IMAGE_DIR=./static/images
VIDEO_DIR=./static/videos
